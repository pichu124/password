<?xml version="1.0" encoding="utf-8"?>
<!-- Không đưa dữ liệu của app (bản lưu ngoại tuyến của kho, cấu hình) vào bản sao lưu Google
     hay khi chuyển sang điện thoại mới: bản sao cũ của kho không nên nằm ngoài tầm kiểm soát. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
